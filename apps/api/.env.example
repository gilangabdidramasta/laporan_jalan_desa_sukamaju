# Contoh konfigurasi API. Salin menjadi `.env` bila perlu (dimuat otomatis oleh npm run dev/start).
PORT=4000

# Wajib diganti di produksi.
JWT_SECRET=ubah-menjadi-kunci-acak-yang-panjang

# Hanya dipakai saat basis data masih kosong (seed pertama kali).
SUPERADMIN_EMAIL=superadmin@pekanbaru.go.id
SUPERADMIN_PASSWORD=super12345

# ---------------------------------------------------------------------------
# Penyimpanan (opsional)
# ---------------------------------------------------------------------------
# Kosongkan untuk memakai apps/api/data + apps/api/uploads (SQLite lokal).
# Di Railway, arahkan ke mount volume, mis. /data.
# STORAGE_DIR=/data

# Batas body JSON. Di Vercel maksimal 4mb (batas platform 4,5 MB).
# JSON_BODY_LIMIT=4mb

# ---------------------------------------------------------------------------
# Mode Vercel (opsional; isi keduanya untuk memakai Turso + Vercel Blob)
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://lapor-jalan-xxxx.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
